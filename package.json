{
  "name": "cpclaw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "22.23.3",
    "pnpm": "9.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --if-present run build",
    "test": "pnpm --filter \"./packages/*\" --if-present run test",
    "package:desktop": "pnpm build && node scripts/package-desktop.mjs",
    "test:desktop:knowledge": "pnpm --filter @cpclaw/desktop exec electron ../../scripts/verify-desktop-knowledge.mjs",
    "test:desktop:chat": "pnpm --filter @cpclaw/desktop exec electron ../../scripts/verify-desktop-chat.mjs",
    "test:desktop:market": "pnpm --filter @cpclaw/desktop exec electron ../../scripts/verify-desktop-market.mjs",
    "test:desktop:documents": "pnpm --filter @cpclaw/desktop exec electron ../../scripts/verify-desktop-documents.mjs"
  },
  "dependencies": {
    "@cpclaw/contracts": "workspace:*",
    "@cpclaw/desktop-host": "workspace:*",
    "@cpclaw/harness-adapter": "workspace:*",
    "@cpclaw/model-gateway": "workspace:*",
    "@cpclaw/platform": "workspace:*",
    "@cpclaw/verification": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
