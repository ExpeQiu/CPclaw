# 复制为 deploy/platform/.env 后填入。不要入库。
# 公网主机上的 fixture 口令仅供联调；3928 必须白名单本机出口 IP。

AI_MOCK_MODE=true
CPCLAW_DATA_DIR=/data
CPCLAW_PLATFORM_PORT=3928
CPCLAW_LISTEN_HOST=0.0.0.0
CPCLAW_PLATFORM_SEED=fixture

# 至少 32 位，字母数字或 +/=_-
CPCLAW_SESSION_SECRET=

# 可选
# CPCLAW_ACCESS_TTL_SEC=900
# CPCLAW_REFRESH_TTL_SEC=604800
